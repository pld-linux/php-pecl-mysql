mysql_fetch_object() freed only the array of constructor arguments, leaking
the reference zend_fcall_info_args() took on each of them.

--- a/php_mysql.c	2026-11-21 23:03:45.616666666 +0100
+++ b/php_mysql.c	2026-11-21 23:03:45.703333333 +0100
@@ -2338,9 +2338,7 @@ static void php_mysql_fetch_hash(INTERNA
 					zval_ptr_dtor(&retval);
 				}
 			}
-			if (fci.params) {
-				efree(fci.params);
-			}
+			zend_fcall_info_args_clear(&fci, 1);
 		} else if (ctor_params) {
 			zend_throw_exception_ex(zend_ce_exception, 0, "Class %s does not have a constructor hence you cannot use ctor_params", ZSTR_VAL(ce->name));
 		}
